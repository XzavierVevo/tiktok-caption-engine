# Copy to .env and fill in values. Never commit .env or secrets/.

# --- Dev-only (no Google login; uid "dev"; no cloud chat sync) ---
# ALLOW_DEV_NO_AUTH=1

# --- Firebase Auth (web config; same project as workers.dev) ---
FIREBASE_PROJECT_ID=YOUR_VALUE
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=YOUR_VALUE

# --- Legacy Firebase Admin (disabled after the D1 cutover) ---
# Kept only for an explicit rollback. Do not configure this in production.
# FIREBASE_SERVICE_ACCOUNT_FILE=YOUR_VALUE
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- R2 (same bucket as Cloudflare; needed for large chats + media) ---
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=YOUR_VALUE

# --- Authoritative application state (Cloudflare D1) ---
USERSTORE_PRIMARY=d1
USERSTORE_DUAL_WRITE=0
USERSTORE_SHADOW_READ=0
# Public Worker origin; /_internal/state/* still requires INTERNAL_API_KEY.
CLOUDFLARE_STATE_BASE_URL=https://tiktok-caption-tool.YOUR-SUBDOMAIN.workers.dev
# Generate with: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# DATA_ENCRYPTION_KEY_V1=
DATA_ENCRYPTION_ACTIVE_KID=v1

# --- TikTok Marketing API (Caption Tool app). Never commit the secret. ---
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=
# TIKTOK_REDIRECT_URI=YOUR_VALUE

# PROVISION_BILLING_GEO=SE
# PROVISION_BILLING_VAT_ID=se_556517
# Other Swedish VAT: se_556526  (SE556526336401)
# PROVISION_ADD_BALANCE_AMOUNT=10
# PROVISION_MERCURY_DAILY_LIMIT=50
# Click Make Payment during warm-up (default off). Set 1 to fill the card and charge.
# PROVISION_SUBMIT_PAYMENT=0
# Card lives in data/billing_card.json or Settings → Business Center (never commit PAN).
# PROVISION_CARD_NUMBER=
# PROVISION_CARD_EXP=
# PROVISION_CARD_CVV=
# PROVISION_CARD_NAME=
# Extra Ads Manager accounts per BC (named "{BC} 2", "{BC} 3", …). Seed account is 1.
# 0 = only the seed Ads Manager (one ad account per BC).
# PROVISION_EXTRA_AD_ACCOUNTS=0
# One-time budget applied to the seed Ads Manager right after adding balance.
# PROVISION_AD_ACCOUNT_BUDGET=5
# PROVISION_AD_ACCOUNT_BUDGET_MODE=one-time
# White-hat Reach campaign Spark code (Ads Manager paste). Overrides Settings.
# PROVISION_SPARK_CODE=
# Sales Instant Page: implement Publish but keep off for testing (set 1 to go live).
# PROVISION_SALES_PUBLISH=0

# --- Provision worker / AdsPower (BCs tab) ---
# Must match the authenticated UID (or leave unset to auto-discover).
# PROVISION_OWNER_UID=
# Do NOT set CAPTION_DEV_UID=dev while using a real production login — worker will look offline.
# CAPTION_DEV_UID=
# PROVISION_EMBED_WORKER=1
# PROVISION_WORKER_TOKEN=
# PROVISION_WORKER_CONCURRENCY=4
# Local bat: CLOUD_API_BASE is forced to https://127.0.0.1:8765
# Default start.bat = local API + worker that also claims production warm-ups.
# Worker-only: start.bat cloud → https://tiktok-caption-tool.YOUR-SUBDOMAIN.workers.dev
# CLOUD_API_BASE=https://tiktok-caption-tool.YOUR-SUBDOMAIN.workers.dev
# Test-only: reuse one Hoot BC / one proxy (defaults OFF).
# PROVISION_SACRIFICE_HOOT=0
# PROVISION_SACRIFICE_HOOT_ID=
# PROVISION_SACRIFICE_HOOT_EMAIL=
# PROVISION_SACRIFICE_HOOT_PASSWORD=
# PROVISION_SACRIFICE_PROXY=0

# --- LLM providers (chat / hooks / captions) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Opus text (hooks, ask_models) uses the Claude CLI subscription inside the
# Cloudflare container, not this API key. Create the token on your machine:
#   claude setup-token
# then: wrangler secret put CLAUDE_CODE_OAUTH_TOKEN
# CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_CLI_MODEL=opus
# GEMINI_API_KEY=
# OPENAI_BASE_URL=

# --- Hoot / Webshare / AdsPower / captcha ---
# HOOT_API_KEY=
# HOOT_API_BASE=
# WEBSHARE_API_KEY=
# ADSPOWER_API_KEY=
# ADSPOWER_API_BASE=http://127.0.0.1:50325
# TWOCAPTCHA_API_KEY=
# CAPTCHA_API_KEY=

# --- DuoPlus (spark fetch) ---
# DUOPLUS_API_KEY=
# DUOPLUS_API_BASE=
# DUOPLUS_BASE_URL=

# --- Meta / Facebook ---
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# --- Internal Worker ↔ container ---
# INTERNAL_API_KEY=
# SPARK_CALLBACK_SECRET=
# SPARK_CALLBACK_BASE_URL=
# ALLOW_DEV_NO_AUTH=0
# CAPTION_ALLOW_X_DEV_UID=0
# TIKTOK_SIGNER_ENABLED=1
# TIKTOK_SIGNER_PORT=8081
# TIKTOK_SIGNER_URL=http://127.0.0.1:8081


# Spark reliability rollout: legacy stays default; canary verified_ui on an idle phone.
# DUOPLUS_SPARK_ENGINE=legacy
# DUOPLUS_SPARK_UI_LABELS_JSON={}
# Optional host-to-ingress callback delivery (both drivers); requires public HTTPS base + secret.
# DUOPLUS_SPARK_CALLBACK_ENABLED=0
# Central scheduling rollout. Deploy the WorkCoordinator and updated API/PC
# worker together; keep disabled until resource-isolation canaries pass.
ORCHESTRATION_ENABLED=0
ORCHESTRATION_BASE_URL=
ORCHESTRATION_PROFILES=3
